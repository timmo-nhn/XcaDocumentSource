    "XdsConfiguration": {
      "ApiKeyEnabled": true,
      "ApiKey": "test-123123123",
      "AtnaLogExporterEndpoint": "/tests/AuditEvent",
      "ClamavEndpoint": "localhost",
      "ClamavEnabled": true,
      "SigningCertificateUrls": "https://helseid-sts.test.nhn.no/.well-known/openid-configuration/jwks;https://eksternapi.hn.test.nhn.no/sts/oidcprov/v3/jwk",
      "ValidAudiences": "https://ptr1xds-reg.prod.drift.nhn.no/;https://xds-web.test.nhn.no/;nhn:dokumentdeling-saml",
